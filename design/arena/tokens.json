{
  "meta": {
    "name": "Training Arena design tokens",
    "version": "1.0.0",
    "updated": "2026-09-17",
    "owner": "task 01 (design system and prototype)",
    "documentation": "design/arena/DESIGN_SYSTEM.md",
    "mirror": "prototype/styles/tokens.css",
    "consumers": ["task 02 media", "task 05 challenge web", "task 06 account", "task 07 battle UI", "task 09 result sharing"],
    "rule": "This file is the single source of truth. Update it first, then DESIGN_SYSTEM.md, then prototype/styles/tokens.css. prototype/scripts/check.mjs fails on drift."
  },
  "color": {
    "canvas": "#17191A",
    "surface": "#242729",
    "raised": "#303537",
    "line": "#3B4245",
    "lineStrong": "#6F787A",
    "player": "#D6FF3F",
    "playerInk": "#17191A",
    "playerWash": "#2A2F1B",
    "opponent": "#BEA1FF",
    "opponentInk": "#17191A",
    "opponentWash": "#2B2637",
    "text": "#F6F7F2",
    "textSecondary": "#B6BDB9",
    "textQuiet": "#9BA59E",
    "positive": "#7AE5A0",
    "warning": "#FFD66E",
    "danger": "#FF807C",
    "focus": "#F6F7F2",
    "overlay": "rgba(23, 25, 26, 0.78)"
  },
  "contrastChecks": [
    { "fg": "text", "bg": "canvas", "min": 4.5, "note": "body text" },
    { "fg": "text", "bg": "surface", "min": 4.5, "note": "body text on surface" },
    { "fg": "text", "bg": "raised", "min": 4.5, "note": "body text on cards" },
    { "fg": "textSecondary", "bg": "canvas", "min": 4.5, "note": "secondary copy" },
    { "fg": "textSecondary", "bg": "surface", "min": 4.5, "note": "secondary copy on surface" },
    { "fg": "textSecondary", "bg": "raised", "min": 4.5, "note": "secondary copy on cards" },
    { "fg": "textQuiet", "bg": "canvas", "min": 4.5, "note": "meta copy" },
    { "fg": "textQuiet", "bg": "surface", "min": 4.5, "note": "meta copy on surface" },
    { "fg": "textQuiet", "bg": "raised", "min": 4.5, "note": "meta copy on cards" },
    { "fg": "player", "bg": "canvas", "min": 4.5, "note": "player identity and links" },
    { "fg": "player", "bg": "surface", "min": 4.5, "note": "player identity on surface" },
    { "fg": "player", "bg": "raised", "min": 4.5, "note": "player identity on cards" },
    { "fg": "playerInk", "bg": "player", "min": 4.5, "note": "primary button label" },
    { "fg": "opponent", "bg": "canvas", "min": 4.5, "note": "opponent identity" },
    { "fg": "opponent", "bg": "surface", "min": 4.5, "note": "opponent identity on surface" },
    { "fg": "opponent", "bg": "raised", "min": 4.5, "note": "opponent identity on cards" },
    { "fg": "opponentInk", "bg": "opponent", "min": 4.5, "note": "opponent identity chip label" },
    { "fg": "positive", "bg": "canvas", "min": 4.5, "note": "success and online state" },
    { "fg": "positive", "bg": "surface", "min": 4.5, "note": "success on surface" },
    { "fg": "warning", "bg": "canvas", "min": 4.5, "note": "warning and reconnecting state" },
    { "fg": "warning", "bg": "surface", "min": 4.5, "note": "warning on surface" },
    { "fg": "danger", "bg": "canvas", "min": 4.5, "note": "danger and tracking loss" },
    { "fg": "danger", "bg": "surface", "min": 4.5, "note": "danger on surface" },
    { "fg": "lineStrong", "bg": "canvas", "min": 3.0, "note": "input and control boundaries" },
    { "fg": "lineStrong", "bg": "surface", "min": 3.0, "note": "input boundaries on surface" },
    { "fg": "player", "bg": "playerWash", "min": 4.5, "note": "player text on lime-tinted wash" },
    { "fg": "opponent", "bg": "opponentWash", "min": 4.5, "note": "opponent text on violet-tinted wash" },
    { "fg": "text", "bg": "playerWash", "min": 4.5, "note": "body text on lime-tinted wash" },
    { "fg": "text", "bg": "opponentWash", "min": 4.5, "note": "body text on violet-tinted wash" }
  ],
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "pill": "999px"
  },
  "type": {
    "family": "Inter",
    "fallback": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "scale": {
      "display": { "rem": "4.5rem", "px": 72, "weight": 900, "lineHeight": 0.9, "tracking": "-0.03em", "usage": "live timer, final score digits" },
      "score": { "rem": "3.25rem", "px": 52, "weight": 900, "lineHeight": 0.95, "tracking": "-0.02em", "usage": "score panels, countdown digits" },
      "h1": { "rem": "2.125rem", "px": 34, "weight": 800, "lineHeight": 1.1, "tracking": "-0.02em", "usage": "screen title, result headline" },
      "h2": { "rem": "1.5rem", "px": 24, "weight": 800, "lineHeight": 1.2, "tracking": "-0.01em", "usage": "card title" },
      "h3": { "rem": "1.125rem", "px": 18, "weight": 700, "lineHeight": 1.3, "tracking": "0", "usage": "component title" },
      "body": { "rem": "1rem", "px": 16, "weight": 500, "lineHeight": 1.5, "tracking": "0", "usage": "body copy" },
      "small": { "rem": "0.875rem", "px": 14, "weight": 500, "lineHeight": 1.45, "tracking": "0", "usage": "helper and meta copy" },
      "micro": { "rem": "0.75rem", "px": 12, "weight": 700, "lineHeight": 1.3, "tracking": "0.08em", "usage": "uppercase identity tag only, never critical information" }
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "260ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduced": "respect prefers-reduced-motion: remove transforms, keep instant state changes"
  },
  "focus": {
    "ring": "3px solid #F6F7F2",
    "offset": "2px",
    "rule": "Never remove the focus ring. On soft-white surfaces switch the ring to canvas #17191A."
  },
  "targets": {
    "minTouch": "48px",
    "bottomNav": "64px"
  },
  "layout": {
    "contentMaxMobile": "560px",
    "contentMaxDesktop": "1040px",
    "desktopBreakpoint": "900px",
    "safeInset": "clamp(16px, 5vw, 24px)"
  }
}
