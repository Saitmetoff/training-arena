# Only development/preview; all keys stay server-side. Populate through the secure environment store.
FAULT_SITE_URL=http://127.0.0.1:3000
# development uses the isolated preview schema at runtime. Hosted check:launch
# requires an explicit preview or production value and a verified HTTPS origin.
FAULT_ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
FAULT_ENCRYPTION_KEY=
FAULT_RATE_LIMIT_SECRET=
FAULT_DISPATCH_SECRET=
# Required only for the authenticated daily Vercel retry backstop in vercel.json.
# An external dispatcher can instead use FAULT_DISPATCH_SECRET; verify retry cadence.
CRON_SECRET=
FAULT_TEST_RECIPIENTS=
# Optional analytics delivery. Database signup/counts do not depend on PostHog.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Local integration seam only. Refused on Vercel or non-loopback URLs.
FAULT_LOCAL_TEST_MODE=false
FAULT_DELIVERY_READY=false
# App Links only; not required to collect waitlist interest. Use the real release certificate.
FAULT_ANDROID_CERT_SHA256=
