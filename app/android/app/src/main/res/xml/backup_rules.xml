<?xml version="1.0" encoding="utf-8"?>
<!--
  L03: pre-Android-12 (API <= 30) full-backup exclusions. Kept in sync with
  res/xml/data_extraction_rules.xml so no credential-bearing preference is
  eligible for cloud backup or transfer on any supported API level.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
</full-backup-content>
