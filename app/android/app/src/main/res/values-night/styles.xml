<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The arena identity is charcoal-only, so light and dark mode use the
         same window background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/arena_charcoal</item>
        <item name="android:navigationBarColor">@color/arena_charcoal</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/arena_charcoal</item>
    </style>
</resources>
