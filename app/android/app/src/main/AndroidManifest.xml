<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The arena client needs the network for sign-in and authoritative
         match state. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Task 08: Android 13 (API 33) requires a runtime permission before any
         notification can be posted. It is requested in context on the first
         challenge request; denial leaves the in-app inbox authoritative. The
         native host also creates the `arena_requests`/`arena_matches`
         channels (see docs/notifications/ANDROID_PUSH_SETUP.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Task 03: rep counting runs on-device with ML Kit Pose Detection.
         Frames are processed in memory and never uploaded, so no storage or
         network permission is involved. The camera is declared optional so
         the app still installs on camera-less devices and can show the
         actionable no-camera error. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"/>
    <!-- Explicit so the implicit requirement from the CAMERA permission does
         not filter camera-less devices out of installs; those devices get the
         actionable no-camera error instead. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"/>
    <application
        android:label="Fault"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <!-- L03: cloud backup is off, and Android 12+ device-to-device
             transfer plus pre-12 full backup explicitly exclude all
             preference/file/database data, because allowBackup="false" alone
             does not stop every manufacturer transfer flow. Sessions are
             Keystore-backed and not portable; see
             docs/release/CONFIGURATION.md. -->
        <!-- Task 08: server push uses the `arena_requests` channel unless the
             notification payload names another channel. The native FCM host
             (task 11) creates both channels; see
             docs/notifications/ANDROID_PUSH_SETUP.md. No Firebase credential
             is committed. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="arena_requests"/>
        <!-- Task 11 / L06: the native FCM host. The service is inert until the
             owner supplies google-services.json and the Google Services plugin
             runs; without it no token or message can arrive. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_arena_notification"/>
        <service
            android:name=".push.ArenaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- app_links receives link intents itself; the Flutter default
                 deep-link router would try to resolve a named route and fail
                 (see docs/decisions/05-challenge-link-interface-decisions.md). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Challenge App Links (task 05). The host comes from the Gradle
                 property `arenaLinkHost` (default example.invalid) so the real
                 domain is configured with `-ParenaLinkHost=<host>` and stays
                 in sync with ARENA_LINK_HOST. autoVerify needs
                 https://<host>/.well-known/assetlinks.json with the
                 delegate_permission/common.handle_all_urls relation and this
                 app's release fingerprint; verification cannot succeed on
                 example.invalid. See challenge-web/README.md. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="${arenaLinkHost}"
                    android:pathPrefix="/c/"/>
            </intent-filter>
            <!-- Local fallback scheme, fixed by decision 05. Shared messages
                 always use the HTTPS form. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="trainingarena"
                    android:host="challenge"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
